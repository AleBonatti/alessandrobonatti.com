# Everything in /_astro/ is generated by the build with a content hash in its file name
# (e.g. index.3RzSEWWB.css): a changed file gets a new name, so browsers may cache them forever.
# A per-folder .htaccess avoids <If> blocks, which not every Apache-compatible server supports.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
