---
/**
 * HTML shell shared by every public page: <head> (SEO, hreflang, fonts, language detection),
 * scroll progress bar and the .site wrapper.
 */
import { Font } from 'astro:assets';
import '../styles/global.css';
import { DEFAULT_LOCALE, LANG_STORAGE_KEY, homePath, type Locale } from '../i18n/locales';
import { PUBLISHED_LOCALES } from '../i18n/published';
import { PRODUCTION_SITE, isProductionSite } from '../lib/deploy';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Redirect to the visitor's preferred language. Only the English home page enables it. */
  detectLanguage?: boolean;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Translated "Skip to content"; the link targets <main id="main">. Omit on pages without it. */
  skipLabel?: string;
}

const { locale, title, description, detectLanguage = false, skipLabel } = Astro.props;

// Astro.site comes from `site` in astro.config.mjs (SITE_URL env var); Astro.url is this page's URL.
const site = Astro.site ?? new URL(PRODUCTION_SITE);
// Staging builds (e.g. dev.alessandrobonatti.com) stay out of search engines.
const production = isProductionSite(site);
const noindex = Astro.props.noindex === true || !production;
const canonical = new URL(Astro.url.pathname, site).href;
// Only languages that are live on this build (see src/i18n/published.ts).
const alternates = PUBLISHED_LOCALES.map((l) => ({ hreflang: l, href: new URL(homePath(l), site).href }));
const ogLocale: Record<Locale, string> = { en: 'en_US', it: 'it_IT', sv: 'sv_SE' };

---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* Browser-language detection, only on the default-language home page ("/").
         Runs before anything renders: if the visitor has no saved choice and prefers a
         language we support, jump to its URL. An explicit choice (saved by the language
         switcher) always wins. Pages /it/ and /sv/ never redirect: an explicit URL is respected.
         Unreleased languages are not in the list, so production never redirects to them. */
      detectLanguage && locale === DEFAULT_LOCALE && (
        <script is:inline define:vars={{ locales: PUBLISHED_LOCALES, storageKey: LANG_STORAGE_KEY, fallback: DEFAULT_LOCALE }}>
          (function () {
            var target = null;
            try {
              target = localStorage.getItem(storageKey);
            } catch (e) {}
            if (locales.indexOf(target) === -1) {
              target = null;
              var prefs = navigator.languages || [navigator.language];
              for (var i = 0; i < prefs.length; i++) {
                var code = String(prefs[i] || '').slice(0, 2).toLowerCase();
                if (locales.indexOf(code) !== -1) { target = code; break; }
              }
            }
            if (target && target !== fallback) location.replace('/' + target + '/' + location.hash);
          })();
        </script>
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="theme-color" content="#000000" />

    {/* .ico for old browsers (sizes="32x32" stops Chrome preferring it over the SVG), SVG for the rest. */}
    <link rel="icon" href="/favicon/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    {/* Self-hosted fonts (see `fonts` in astro.config.mjs). Preload only what's above the fold. */}
    <Font cssVariable="--font-sans" preload={[{ weight: 800, style: 'normal' }, { weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-serif" preload={[{ style: 'italic' }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    {skipLabel && <a class="skip" href="#main">{skipLabel}</a>}
    <div class="site">
      <div class="progress" aria-hidden="true"></div>
      <slot />
    </div>
  </body>
</html>
