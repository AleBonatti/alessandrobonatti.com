---
/**
 * The home page, in every language.
 *
 * `[...lang]` is a *rest* route parameter: unlike `[lang]` it may also be empty (undefined),
 * so this single file produces "/" (English), "/it/" and "/sv/".
 * In a static build, getStaticPaths() tells Astro which URLs to pre-render.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/sections/Hero.astro';
import About from '../../components/sections/About.astro';
import Skills from '../../components/sections/Skills.astro';
import Languages from '../../components/sections/Languages.astro';
import Experience from '../../components/sections/Experience.astro';
import Showcase from '../../components/sections/Showcase.astro';
import Education from '../../components/sections/Education.astro';
import Passions from '../../components/sections/Passions.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/sections/Footer.astro';
import FloatingActions from '../../components/FloatingActions.astro';
import { getSiteContent } from '../../lib/content';
import { DEFAULT_LOCALE } from '../../i18n/locales';
import { PUBLISHED_LOCALES } from '../../i18n/published';

// Only live languages get a page: an unreleased one simply doesn't exist on production (404).
export const getStaticPaths = (() =>
  PUBLISHED_LOCALES.map((locale) => ({
    params: { lang: locale === DEFAULT_LOCALE ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

// Derive the Props type from what getStaticPaths returns: no duplication, no `any`.
// Declaring a type named `Props` is enough for Astro to type `Astro.props` with it.
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale } = Astro.props;
const t = await getSiteContent(locale);
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} detectLanguage skipLabel={t.nav.skip}>
  <Header locale={locale} t={t} />
  {/* tabindex="-1": the skip link can move keyboard focus here, not just scroll. */}
  <main id="main" tabindex="-1">
    <Hero locale={locale} t={t} />
    <About t={t} />
    <Skills t={t} />
    <Languages t={t} />
    <Experience t={t} />
    <Showcase t={t} />
    <Education t={t} />
    <Passions t={t} />
    <Contact t={t} />
  </main>
  {/* Before the footer: the buttons' sticky dock comes to rest right above it. */}
  <FloatingActions locale={locale} t={t} />
  <Footer t={t} />
</BaseLayout>
