---
/**
 * Not-found page. Astro emits it as dist/404.html; the web server must be told to use it
 * (see public/.htaccess). The language is unknown here, so it greets in every live language.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOCALES, LOCALE_LABELS, homePath } from '../i18n/locales';
import { PUBLISHED_LOCALES } from '../i18n/published';

const messages = {
  en: 'This page doesn’t exist.',
  it: 'Questa pagina non esiste.',
  sv: 'Den här sidan finns inte.',
} as const satisfies Record<(typeof LOCALES)[number], string>;
---

<BaseLayout locale="en" title="404 — Alessandro Bonatti" description="Page not found" noindex>
  <section id="top" class="dark nf">
    <div class="container">
      <p class="mono kicker">Error 404</p>
      <h1>Hej<span class="serif-i">?</span></h1>
      <ul class="list">
        {
          PUBLISHED_LOCALES.map((l) => (
            <li lang={l}>
              <span>{messages[l]}</span>
              <a class="flink" href={homePath(l)}>
                {LOCALE_LABELS[l]} →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    background: var(--black);
    color: var(--white);
    min-height: 100vh;
  }
  .kicker {
    margin: 0 0 24px;
    color: var(--yellow);
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 48px;
    font-weight: 800;
    font-size: clamp(46px, 6vw, 88px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    font-size: 18px;
  }
  .list li {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .flink {
    color: var(--yellow);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.35s ease;
  }
  .flink:hover {
    color: var(--yellow);
    background-size: 100% 2px;
  }
</style>
