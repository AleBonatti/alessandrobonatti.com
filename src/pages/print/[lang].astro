---
/**
 * Print / PDF version of the CV: same content collection as the site, A4 layout.
 * Not linked anywhere and excluded from the sitemap/robots: it exists only so that
 * scripts/generate-pdf.ts can render it to dist/cv/*.pdf after each build.
 * Open /print/en/ in the dev server to iterate on the layout.
 */
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { Font } from 'astro:assets';
import '../../styles/global.css';
import Rich from '../../components/Rich.astro';
import { getSiteContent } from '../../lib/content';
import { homePath } from '../../i18n/locales';
import { PUBLISHED_LOCALES } from '../../i18n/published';
import { profile } from '../../data/profile';

// No print page (hence no PDF) for unreleased languages.
export const getStaticPaths = (() => PUBLISHED_LOCALES.map((locale) => ({ params: { lang: locale }, props: { locale } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale } = Astro.props;
const t = await getSiteContent(locale);

const siteUrl = new URL(homePath(locale), Astro.site ?? 'https://alessandrobonatti.com').href;
const siteLabel = siteUrl.replace(/^https:\/\//, '').replace(/\/$/, '');
const linkedin = profile.social.find((s) => s.id === 'linkedin');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{t.meta.title}</title>
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <div class="cv">
      {/* No photo on purpose: the PDF is text only (also friendlier to ATS parsers and anonymous screening). */}
      <header class="top">
        <div class="id">
          <p class="mono kicker">{t.hero.role} · {t.hero.basedIn} {t.hero.location}</p>
          <h1>{profile.name.first} <span class="serif-i">{profile.name.last}</span></h1>
          <p class="summary">{t.hero.summary}</p>
          <ul class="mono contacts" aria-label={t.print.contacts}>
            <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
            {profile.phones.map((p) => <li><a href={`tel:${p.tel}`}>{p.display}</a></li>)}
            <li><a href={siteUrl}>{siteLabel}</a></li>
            {linkedin && <li><a href={linkedin.url}>{linkedin.url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>}
            <li><a href={profile.github.url}>{profile.github.label}</a></li>
          </ul>
        </div>
      </header>

      <section>
        <h2 class="mono">{t.about.title}</h2>
        <p class="statement"><span class="serif-i">{t.about.lead}</span> <Rich as="span" text={t.about.statement} /></p>
        <div class="two-col">
          {t.about.paragraphs.map((p) => <Rich text={p} />)}
        </div>
      </section>

      <section>
        <h2 class="mono">{t.experience.title}</h2>
        {
          t.experience.jobs.map((job) => (
            <div class="entry">
              <div class="mono when">{job.years}</div>
              <div>
                <h3>
                  {job.company} <span class="serif-i role">{job.role}</span> <span class="where">· {job.location}</span>
                </h3>
                <Rich text={job.description} />
              </div>
            </div>
          ))
        }
      </section>

      <section>
        <h2 class="mono">{t.skills.title}</h2>
        {
          t.skills.groups.map((g) => (
            <div class="entry">
              <div class="mono when"><span class="letter">{g.letter}</span></div>
              <div>
                <h3>{g.title}</h3>
                <Rich text={g.description} />
                <ul class="mono chips">
                  {g.tiles.map((tile) => <li>{tile.name}</li>)}
                  {g.also.map((name) => <li class="also">{name}</li>)}
                </ul>
              </div>
            </div>
          ))
        }
      </section>

      <section>
        <h2 class="mono">{t.languages.title}</h2>
        <ul class="langs">
          {
            t.languages.items.map((l) => (
              <li>
                <span class="serif-i lname">{l.name}</span> <strong>{l.level}</strong> · {l.detail}
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="mono">{t.showcase.title}</h2>
        <Rich text={t.showcase.intro} class="intro" />
        <div class="projects">
          {
            t.showcase.projects.map((p) => (
              <div class="project">
                <div class="mono ctx">{p.context}</div>
                {/* Site paths (/seppia-cms/) become full URLs: a PDF has no "current site" to resolve them against. */}
                <h3><a href={new URL(p.url, siteUrl).href}>{p.name}</a></h3>
                <p>{p.description}</p>
                <p class="small"><span class="mono label">{t.showcase.labels.role}</span> {p.role}</p>
                <p class="small"><span class="mono label">{t.showcase.labels.tech}</span> {p.tech.join(' · ')}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="mono">{t.education.title}</h2>
        {
          t.education.items.map((e) => (
            <div class="entry">
              <div class="mono when">{e.years}</div>
              <div>
                <h3>{e.title}</h3>
                <p class="small muted">{e.detail} · {e.location}</p>
                <Rich text={e.description} />
              </div>
            </div>
          ))
        }
        <p class="note"><span class="serif-i">{t.education.note.title}</span> {t.education.note.text}</p>
      </section>

      <section>
        <h2 class="mono">{t.passions.title}</h2>
        <div class="three-col">
          {t.passions.items.map((p) => <Rich text={p.text} />)}
        </div>
      </section>

      <footer class="mono foot">
        {t.print.downloadNote} <a href={siteUrl}>{siteLabel}</a>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* Page box for the PDF: A4 with margins; Playwright honours this via preferCSSPageSize. */
  @page {
    size: A4;
    margin: 14mm 15mm 14mm;
  }
  html,
  body {
    margin: 0;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .cv {
    font-family: var(--font-sans);
    font-size: 9pt;
    line-height: 1.42;
    color: #000;
  }
  .cv a {
    color: inherit;
    text-decoration: none;
  }
  .cv p {
    margin: 0 0 0.5em;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8mm;
    padding-bottom: 5mm;
    border-bottom: 1.5pt solid #000;
  }
  .kicker {
    margin: 0 0 2mm;
    font-size: 8pt;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey-dark);
  }
  h1 {
    margin: 0;
    font-size: 32pt;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  h1 .serif-i {
    letter-spacing: -0.02em;
  }
  .summary {
    max-width: 150mm;
    margin: 3mm 0 0;
    font-size: 10.5pt;
    line-height: 1.4;
    color: var(--grey-dark);
  }
  .contacts {
    list-style: none;
    margin: 4mm 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1mm 5mm;
    font-size: 7.5pt;
    letter-spacing: 0.03em;
  }

  /* Clear separation between sections (the PDF is read on screen, so air beats density). */
  section {
    margin-top: 10mm;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 3mm;
    margin: 0 0 5mm;
    font-size: 8pt;
    font-weight: 500;
    /* Moderate tracking: very wide letter-spacing makes PDF text extractors (and recruiters'
       ATS parsers) read "A B O U T" instead of "ABOUT". */
    letter-spacing: 0.08em;
    text-transform: uppercase;
    break-after: avoid;
  }
  h2::after {
    content: '';
    flex: 1;
    height: 0.75pt;
    background: #000;
  }
  h2::before {
    content: '';
    order: 2;
    width: 2.2mm;
    height: 2.2mm;
    /* A border, not an outline: an outline is drawn outside the box, and at the right edge of
       the page it was clipped by the margin. box-sizing keeps the square at 2.2mm overall. */
    box-sizing: border-box;
    background: var(--yellow);
    border: 0.75pt solid #000;
  }
  h3 {
    margin: 0 0 1mm;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: -0.01em;
    break-after: avoid;
  }
  .statement {
    font-size: 15pt;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .two-col {
    columns: 2;
    column-gap: 7mm;
    color: var(--grey-dark);
  }
  .three-col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6mm;
    color: var(--grey-dark);
  }
  .entry {
    display: grid;
    grid-template-columns: 26mm 1fr;
    gap: 4mm;
    padding: 2mm 0;
    border-top: 0.5pt solid var(--line-2);
    break-inside: avoid;
  }
  .entry:first-of-type {
    border-top: 0;
  }
  .when {
    font-size: 8pt;
    color: var(--grey-dark);
    padding-top: 0.6mm;
  }
  .role {
    font-weight: 400;
    font-size: 11.5pt;
  }
  .where,
  .muted {
    color: var(--grey-mid);
    font-weight: 400;
  }
  .small {
    font-size: 8.5pt;
  }
  .letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5mm;
    height: 5mm;
    background: #000;
    color: var(--yellow);
  }
  .chips {
    list-style: none;
    margin: 1.5mm 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2mm;
    font-size: 7.5pt;
  }
  .chips li {
    border: 0.5pt solid #bdbdb8;
    padding: 0.4mm 1.6mm;
  }
  /* Daily tools first; "also used" ones follow in grey with a dashed border. */
  .chips li.also {
    border-style: dashed;
    color: var(--grey-mid);
  }
  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 8mm;
  }
  .lname {
    font-size: 13pt;
  }
  /* .cv .intro, not .intro: the general `.cv p` margin rule would otherwise win. */
  .cv .intro {
    margin-bottom: 5mm;
    color: var(--grey-dark);
  }
  /* A grid with real rows: cards read in order, two per row, aligned at the top. A row that
     doesn't fit moves to the next page as a whole (multi-column flowed and balanced the
     columns per page instead, leaving one card alone on the left and two stacked on the right). */
  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6mm 7mm;
    align-items: start;
  }
  .project {
    border-top: 0.5pt solid #000;
    padding-top: 2mm;
    break-inside: avoid;
  }
  .ctx,
  .label {
    font-size: 6.8pt;
    letter-spacing: 0.12em;
    color: var(--grey-mid);
  }
  .note {
    margin-top: 2mm;
  }
  .note .serif-i {
    font-size: 12pt;
  }
  .foot {
    margin-top: 5mm;
    padding-top: 3mm;
    border-top: 0.75pt solid #000;
    font-size: 7.5pt;
    color: var(--grey-mid);
  }
  /* The highlight marker, static and a bit thinner for paper. */
  .cv .hl {
    background-size: 100% 38%;
    animation: none;
  }
  .cv .ulink {
    font-weight: 700;
  }
</style>
