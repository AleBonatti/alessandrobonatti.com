---
import LanguageSwitcher, { type LanguageOption } from './LanguageSwitcher';
import type { SiteContent } from '../content.config';
import { LOCALE_LABELS, SWITCHER_ORDER, homePath, type Locale } from '../i18n/locales';
import { profile } from '../data/profile';

interface Props {
  locale: Locale;
  t: SiteContent;
}

const { locale, t } = Astro.props;

const links = [
  { href: '#about', label: t.nav.about },
  { href: '#skills', label: t.nav.skills },
  { href: '#experience', label: t.nav.experience },
  { href: '#showcase', label: t.nav.showcase },
  { href: '#passions', label: t.nav.passions },
  { href: '#contact', label: t.nav.contact },
];

const options: LanguageOption[] = SWITCHER_ORDER.map((l) => ({
  locale: l,
  label: LOCALE_LABELS[l],
  href: homePath(l),
}));
---

<header class="header">
  <div class="inner">
    <a href="#top" class="brand">
      <span class="badge">AB</span><span>{profile.name.first} {profile.name.last}</span>
    </a>
    <nav class="nav mono" aria-label={t.nav.label}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    {/* client:load → hydrate as soon as the page loads (it's visible immediately). */}
    <LanguageSwitcher client:load current={locale} options={options} label={t.languageSwitcher.label} />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    min-height: var(--header-h);
  }
  .brand {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--black);
    color: var(--yellow);
    font-size: 15px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nav a {
    text-decoration: none;
    position: relative;
    padding: 12px 2px;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 6px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .nav a:hover::after {
    transform: scaleX(1);
  }

  /* Language switcher: its markup comes from the React island, outside Astro's scoping,
     so we target it with :global() but keep it namespaced under .header. */
  .header :global(.lang-switch) {
    position: relative;
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .header :global(.lsel) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--black);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .header :global(.lsel:hover) {
    background: var(--yellow);
  }
  .header :global(.chev) {
    transition: transform 0.25s ease;
  }
  .header :global(.lsel[aria-expanded='true'] .chev) {
    transform: rotate(180deg);
  }
  .header :global(.lmenu) {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--black);
    box-shadow: 4px 4px 0 var(--black);
    min-width: 150px;
    z-index: 60;
  }
  .header :global(.lmenu[hidden]) {
    display: none;
  }
  .header :global(.lopt) {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    text-decoration: none;
    background: transparent;
    color: var(--black);
    transition: background-color 0.2s ease;
  }
  .header :global(.lopt.is-active) {
    background: var(--black);
    color: var(--yellow);
  }
  .header :global(.lopt:hover) {
    background: var(--yellow);
    color: var(--black);
  }
  .header :global(.lcode) {
    opacity: 0.7;
  }
</style>
