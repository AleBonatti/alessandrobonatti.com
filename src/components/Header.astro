---
import LanguageSwitcher, { type LanguageOption } from './LanguageSwitcher';
import type { SiteContent } from '../content.config';
import { LOCALE_LABELS, SWITCHER_ORDER, homePath, type Locale } from '../i18n/locales';
import { PUBLISHED_LOCALES } from '../i18n/published';
import { profile } from '../data/profile';
// Importing an .svg gives an Astro component that inlines the <svg> markup in the HTML:
// no extra request, razor-sharp at any size. Props become attributes on the <svg>.
import Logo from '../assets/logo.svg';

interface Props {
  locale: Locale;
  t: SiteContent;
}

const { locale, t } = Astro.props;

const links = [
  { href: '#about', label: t.nav.about },
  { href: '#skills', label: t.nav.skills },
  { href: '#experience', label: t.nav.experience },
  { href: '#showcase', label: t.nav.showcase },
  { href: '#passions', label: t.nav.passions },
  { href: '#contact', label: t.nav.contact },
];

// Unreleased languages (see src/i18n/published.ts) get no entry in the switcher.
const options: LanguageOption[] = SWITCHER_ORDER.filter((l) => PUBLISHED_LOCALES.includes(l)).map((l) => ({
  locale: l,
  label: LOCALE_LABELS[l],
  href: homePath(l),
}));
---

<header class="header">
  <div class="inner">
    {/* The visible name is the link's accessible name, so the logo is decorative (aria-hidden). */}
    <a href="#top" class="brand">
      <Logo width={44} height={44} aria-hidden="true" class="logo" />
      <span>{profile.name.first} {profile.name.last}</span>
    </a>
    <nav class="nav mono" aria-label={t.nav.label}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    {/* client:load → hydrate as soon as the page loads (it's visible immediately). Desktop only. */}
    <LanguageSwitcher client:load current={locale} options={options} label={t.languageSwitcher.label} />

    {
      /* Mobile menu button (below 1024px it replaces the nav and the language dropdown).
         popovertarget wires it to the panel natively: click toggles it, Esc and a tap outside
         close it, focus returns here, and screen readers hear "expanded/collapsed" without
         any script. */
    }
    <button type="button" class="burger" popovertarget="mobile-menu" aria-label={t.nav.menu}>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  {
    /* The popover panel lives in the browser's "top layer": above everything else, positioned
       against the viewport even though the header has a backdrop-filter. */
  }
  <div id="mobile-menu" class="mpanel" popover>
    <nav class="mono" aria-label={t.nav.label}>
      <ul class="mlist">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="mrow">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <hr class="msep" />
    {/* Compact language row: the codes are visible, the full names are the accessible names. */}
    <ul class="mlangs mono" aria-label={t.languageSwitcher.label}>
      {
        options.map((o) => (
          <li>
            <a
              href={o.href}
              hreflang={o.locale}
              lang={o.locale}
              class="mlang"
              data-locale={o.locale}
              aria-label={o.label}
              aria-current={o.locale === locale ? 'page' : undefined}
            >
              {o.locale.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  /*
   * Scroll spy: underline the menu link of the section being read.
   *
   * A plain <script> in an .astro file (no is:inline) is processed by Astro: it's TypeScript,
   * bundled and deduplicated, and loaded as a deferred module, so the DOM is ready when it runs.
   *
   * Rule: the active section is the last one (in page order) whose top edge has crossed a line
   * one third down the visible area below the sticky header. Sections without a menu entry
   * (languages, education) keep the previous entry active. At the very bottom of the
   * page the last entry wins, since "contact" may be too short to ever reach the line.
   */
  import { LANG_STORAGE_KEY } from '../i18n/locales';

  const header = document.querySelector<HTMLElement>('.header');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.header .nav a[href^="#"]')];
  // The same sections, listed again in the mobile panel: they get the same aria-current.
  const panelLinks = [...document.querySelectorAll<HTMLAnchorElement>('.mpanel nav a[href^="#"]')];
  const targets = links
    .map((link) => ({ link, section: document.getElementById(link.hash.slice(1)) }))
    .filter((t): t is { link: HTMLAnchorElement; section: HTMLElement } => t.section !== null);

  let current: HTMLAnchorElement | null = null;
  let scheduled = false;

  function update(): void {
    scheduled = false;
    const headerBottom = header?.getBoundingClientRect().bottom ?? 0;
    const line = headerBottom + (window.innerHeight - headerBottom) / 3;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

    let active: HTMLAnchorElement | null = null;
    if (atBottom) {
      active = targets.at(-1)?.link ?? null;
    } else {
      for (const { link, section } of targets) {
        if (section.getBoundingClientRect().top <= line) active = link;
      }
    }

    if (active === current) return;
    // aria-current="location" tells screen readers which in-page section this link points to.
    for (const link of [...links, ...panelLinks]) {
      if (active !== null && link.hash === active.hash) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    current = active;
  }

  // Batch scroll/resize events to at most one update per animation frame.
  function schedule(): void {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(update);
  }

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();

  /*
   * Mobile menu. Opening/closing is native (popover + popovertarget); the script only covers
   * what the browser can't know:
   * - a section link scrolls within the page, so nothing would close the panel: close it;
   * - a language link saves the choice (like the desktop dropdown) and keeps the current #section;
   * - widening the window past the breakpoint hides the button, so close a panel left open.
   */
  const panel = document.getElementById('mobile-menu');
  if (panel) {
    const close = (): void => {
      if (panel.matches(':popover-open')) panel.hidePopover();
    };
    for (const link of panelLinks) link.addEventListener('click', close);

    for (const link of panel.querySelectorAll<HTMLAnchorElement>('a[data-locale]')) {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        try {
          localStorage.setItem(LANG_STORAGE_KEY, link.dataset.locale ?? '');
        } catch {
          // Storage unavailable (privacy mode): the choice just won't persist.
        }
        if (link.getAttribute('aria-current') === 'page') close();
        else window.location.assign(link.pathname + window.location.hash);
      });
    }

    // Same value as the CSS breakpoint below.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    min-height: var(--header-h);
  }
  .brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .logo {
    display: block;
    width: 44px;
    height: 44px;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nav a {
    text-decoration: none;
    position: relative;
    padding: 12px 2px;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 6px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  /* Hover, and the section currently on screen (aria-current is set by the script below). */
  .nav a:hover::after,
  .nav a[aria-current]::after {
    transform: scaleX(1);
  }

  /* ---------- Mobile menu (below 1024px) ----------
     1024px: the widest language (Italian) needs ~980px for logo + nav + switcher on one row. */
  .burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -10px; /* optical: align the bars, not the tap area, with the gutter */
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--black);
    cursor: pointer;
  }
  .bars {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
  }
  .bars > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out), opacity 0.2s ease;
  }
  .bars > span:nth-child(1) {
    top: 0;
  }
  .bars > span:nth-child(2) {
    top: 6px;
  }
  .bars > span:nth-child(3) {
    top: 12px;
  }
  /* Open: the bars become an X. */
  .header:has(.mpanel:popover-open) .bars > span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .header:has(.mpanel:popover-open) .bars > span:nth-child(2) {
    opacity: 0;
  }
  .header:has(.mpanel:popover-open) .bars > span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* The panel: full width, right under the header (72px + its 1px border).
     [popover] has browser defaults (centered, bordered box): reset them. */
  .mpanel {
    position: fixed;
    inset: calc(var(--header-h) + 1px) 0 auto;
    width: auto;
    max-height: calc(100dvh - var(--header-h) - 1px);
    overflow-y: auto;
    margin: 0;
    padding: 8px calc(var(--gutter) - 12px) 24px;
    border: 0;
    border-bottom: 1px solid var(--black);
    background: var(--white);
    color: var(--black);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.14);
  }
  .mlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    padding: 0 12px;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--black);
  }
  @media (hover: hover) {
    .mrow:hover {
      background: var(--yellow);
    }
  }
  /* Current section: the same 2px underline as the desktop menu. */
  .mpanel nav .mrow[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
  }
  .msep {
    margin: 12px 12px 16px;
    border: 0;
    border-top: 1px solid var(--black);
  }
  .mlangs {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0 12px;
    list-style: none;
  }
  .mlang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 44px;
    border: 1px solid var(--black);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--black);
  }
  @media (hover: hover) {
    .mlang:hover {
      background: var(--yellow);
    }
  }
  /* Current language: same black/yellow as the active option of the desktop dropdown. */
  .mlang[aria-current],
  .mlang[aria-current]:hover {
    background: var(--black);
    color: var(--yellow);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Slide/fade in. display and overlay are switched "discretely" so the closing transition
       can play before the popover leaves the top layer; @starting-style is the state it opens from. */
    .mpanel {
      transition:
        opacity 0.22s ease,
        transform 0.32s var(--ease-out),
        overlay 0.32s allow-discrete,
        display 0.32s allow-discrete;
      opacity: 0;
      transform: translateY(-8px);
    }
    .mpanel:popover-open {
      opacity: 1;
      transform: none;
    }
    @starting-style {
      .mpanel:popover-open {
        opacity: 0;
        transform: translateY(-8px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bars > span {
      transition: none;
    }
  }

  @media (max-width: 1023.98px) {
    .nav,
    .header :global(.lang-switch) {
      display: none;
    }
    .inner {
      flex-wrap: nowrap;
    }
    .burger {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    .mpanel {
      display: none;
    }
  }

  /* Language switcher: its markup comes from the React island, outside Astro's scoping,
     so we target it with :global() but keep it namespaced under .header. */
  .header :global(.lang-switch) {
    position: relative;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .header :global(.lsel) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--black);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .header :global(.lsel:hover) {
    background: var(--yellow);
  }
  .header :global(.chev) {
    transition: transform 0.25s ease;
  }
  .header :global(.lsel[aria-expanded='true'] .chev) {
    transform: rotate(180deg);
  }
  .header :global(.lmenu) {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--black);
    box-shadow: 4px 4px 0 var(--black);
    min-width: 150px;
    z-index: 60;
  }
  .header :global(.lmenu[hidden]) {
    display: none;
  }
  .header :global(.lopt) {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    text-decoration: none;
    background: transparent;
    color: var(--black);
    transition: background-color 0.2s ease;
  }
  .header :global(.lopt.is-active) {
    background: var(--black);
    color: var(--yellow);
  }
  .header :global(.lopt:hover) {
    background: var(--yellow);
    color: var(--black);
  }
  .header :global(.lcode) {
    opacity: 0.7;
  }
</style>
