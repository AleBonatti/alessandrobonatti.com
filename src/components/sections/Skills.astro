---
import SectionHeader from '../SectionHeader.astro';
import Rich from '../Rich.astro';
import Icon from '../Icon.astro';
import type { SiteContent } from '../../content.config';

interface Props {
  t: SiteContent;
}

const { skills } = Astro.props.t;
---

<section id="skills">
  <div class="container">
    <SectionHeader title={skills.title} />

    {/* Three groups: side by side on wide screens (the whole section fits about one screen), stacked below. */}
    <div class="groups">
      {
        skills.groups.map((group) => (
          <article class="rv group">
            <div class="ghead">
              <span class="mono letter" aria-hidden="true">
                {group.letter}
              </span>
              <h3>{group.title}</h3>
            </div>
            <Rich text={group.description} class="desc" />
            <div class="tiles">
              {group.tiles.map((tile) => (
                <div class="tile">
                  <span class="ti">
                    {tile.icon ? (
                      <Icon name={tile.icon} size={28} />
                    ) : (
                      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="7" y="7" width="14" height="14" transform="rotate(45 14 14)" />
                      </svg>
                    )}
                  </span>
                  <span class="tname">{tile.name}</span>
                </div>
              ))}
            </div>
            {group.also.length > 0 && (
              <div class="also">
                <span class="mono also-label" id={`also-${group.letter}`}>
                  {skills.alsoLabel}
                </span>
                <ul class="mono chips" aria-labelledby={`also-${group.letter}`}>
                  {group.also.map((name) => (
                    <li>{name}</li>
                  ))}
                </ul>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background: var(--grey-light);
    border-top: 1px solid var(--line);
  }
  .groups {
    display: grid;
    gap: 64px;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  /* From 1200px each column is wide enough for ~40+ characters per line; narrower, stack them.
     Subgrid: the three columns share the same four rows (title, description, tiles, "Also"),
     so the tiles and chips start at the same height in every column, sized by the tallest. */
  @media (min-width: 1200px) {
    .groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      gap: 0 40px;
    }
    .group {
      display: grid;
      grid-row: span 4;
      grid-template-rows: subgrid;
      align-content: start;
      row-gap: 28px;
    }
    /* The shared tiles row is as tall as the column with the most tiles: keep each column's
       tiles at their own height, packed at the top, instead of stretching to fill it. */
    .tiles {
      align-content: start;
    }
  }
  .ghead {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .letter {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--black);
    color: var(--yellow);
    font-size: 13px;
  }
  h3 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(26px, 2.4vw, 32px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  /* 60ch lands around 70 characters per line in practice (ch is the width of "0"). */
  .desc {
    max-width: 60ch;
    margin: 0;
    font-size: 17px;
    color: var(--grey-dark);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(136px, 1fr));
    gap: 10px;
  }
  .tile {
    background: var(--white);
    border: 1px solid var(--line-2);
    padding: 18px 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-height: 104px;
    box-sizing: border-box;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s var(--ease-out), border-color 0.3s ease;
  }
  .ti {
    display: inline-flex;
    color: var(--black);
    transition: color 0.3s ease, transform 0.4s var(--ease-out);
  }
  .tname {
    font-weight: 600;
    font-size: 15px;
    line-height: 1.25;
  }
  /* "Also": secondary tools as compact chips, clearly a step below the daily tiles. */
  /* Label on its own line, chips below: the same structure in every column, so they align. */
  .also {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .also-label {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey-mid);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 5px 10px;
    border: 1px solid var(--line-2);
    background: var(--white);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--grey-dark);
  }
  .tile:hover {
    background: var(--black);
    color: var(--white);
    transform: translateY(-4px);
    border-color: var(--black);
  }
  .tile:hover .ti {
    color: var(--yellow);
    transform: scale(1.15) rotate(-4deg);
  }
</style>
