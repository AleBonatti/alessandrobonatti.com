---
import { profile } from '../../data/profile';

// Evaluated at build time: the year is the build year (the site is rebuilt on every change).
const year = new Date().getFullYear();
---

<footer>
  {/* No "All rights reserved": copyright applies automatically (Berne Convention), the phrase adds nothing. */}
  <p class="mono inner">© {year} {profile.name.first} {profile.name.last}</p>
</footer>

<style>
  footer {
    background: var(--black);
    color: #8a8f8b;
    border-top: 1px solid #222;
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    /* Extra room at the bottom so the floating CV / back-to-top buttons never cover the text. */
    padding: 28px var(--gutter) 96px;
    font-size: 12px;
    letter-spacing: 0.04em;
  }
</style>
