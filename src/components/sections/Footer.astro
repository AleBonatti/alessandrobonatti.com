---
import type { SiteContent } from '../../content.config';
import { profile } from '../../data/profile';

interface Props {
  t: SiteContent;
}

const { footer } = Astro.props.t;
// Evaluated at build time: the year is the build year (the site is rebuilt on every change).
const year = new Date().getFullYear();
const cookieUrl = `https://www.iubenda.com/privacy-policy/${profile.iubenda.cookiePolicyId}/cookie-policy?an=no&s_ck=false&newmarkup=yes`;
---

<footer>
  <div class="mono inner">
    <span>© {year} · {profile.name.first} {profile.name.last} · {footer.rights}</span>
    <a class="ulink iubenda-nostyle" href={cookieUrl} target="_blank" rel="noopener">{footer.cookiePolicy}</a>
  </div>
</footer>

<style>
  footer {
    background: var(--black);
    color: #8a8f8b;
    border-top: 1px solid #222;
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 28px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  a {
    color: #8a8f8b;
  }
  a:hover {
    color: #8a8f8b;
  }
</style>
