---
import SectionHeader from '../SectionHeader.astro';
import { inline } from '../../lib/inline';
import type { SiteContent } from '../../content.config';

interface Props {
  t: SiteContent;
}

const { education } = Astro.props.t;
---

<section id="education">
  <div class="container">
    <SectionHeader title={education.title} />
    <div class="grid">
      {
        education.items.map((e) => (
          <div class="rv">
            <div class="mono years">{e.years}</div>
            <h3>{e.title}</h3>
            <div class="detail">
              {e.detail} <span aria-hidden="true">|</span> {e.location}
            </div>
          </div>
        ))
      }
    </div>
    {/* Full-width rule above, text capped at a reading width below it. */}
    <div class="rv note">
      <p class="note-text">
        <span class="serif-i note-title">{education.note.title}</span> <Fragment set:html={inline(education.note.text)} />
      </p>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--grey-light);
    border-top: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px 64px;
  }
  .years {
    font-size: 14px;
    color: var(--grey-dark);
    margin-bottom: 14px;
  }
  h3 {
    margin: 0 0 10px;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .detail {
    color: var(--grey-mid);
  }
  .note {
    margin: 64px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--black);
  }
  .note-text {
    max-width: 60ch;
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
  }
  .note-title {
    font-size: 28px;
  }
</style>
