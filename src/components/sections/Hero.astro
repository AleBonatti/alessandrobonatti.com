---
import { Image } from 'astro:assets';
// Black & white watercolour illustration (1024×1024 JPG, true black background, so it blends into the hero).
import portrait from '../../assets/portrait-design-patterns-bw.jpg';
import SocialLinks from '../SocialLinks.astro';
import type { SiteContent } from '../../content.config';
import { cvPdfPath, type Locale } from '../../i18n/locales';
import { profile } from '../../data/profile';

interface Props {
  locale: Locale;
  t: SiteContent;
}

const { locale, t } = Astro.props;
---

<section id="top" class="dark hero">
  <div class="inner">
    <div class="rv text">
      <p class="mono kicker">
        {t.hero.role}<span class="kicker-loc"> <span class="lower">{t.hero.basedIn}</span> {t.hero.location}</span>
      </p>
      <h1>{profile.name.first}<br /><span class="serif-i last">{profile.name.last}</span></h1>
      <p class="summary">{t.hero.summary}</p>
      <div class="actions">
        <a class="btn btn-y cv" href={cvPdfPath(locale)} download>
          {/* Two labels, one shown at a time: display:none also hides the other from screen readers. */}
          <span class="cv-long">{t.hero.cvButton}</span>
          <span class="cv-short">{t.hero.cvButtonShort}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"></path></svg>
        </a>
        <SocialLinks size="lg" />
      </div>
    </div>
    <div class="rv photo">
      {/* Astro optimises the image at build time: WebP, 1x/2x srcset, intrinsic width/height (no layout shift). */}
      <Image
        src={portrait}
        alt={t.hero.portraitAlt}
        widths={[320, 640]}
        sizes="320px"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="portrait"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--black);
    color: var(--white);
    overflow: hidden;
  }
  .inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 64px var(--gutter) 64px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .text {
    flex: 1.7 1 520px;
    min-width: 0;
  }
  .kicker {
    margin: 0 0 24px;
    color: var(--yellow);
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .kicker-loc {
    color: var(--white);
  }
  .lower {
    text-transform: none;
  }
  h1 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(46px, 6vw, 88px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .last {
    letter-spacing: -0.02em;
  }
  /* Seniority, scope and availability: readable at a glance without competing with the name. */
  .summary {
    max-width: 34em;
    margin: 28px 0 0;
    color: var(--grey-on-dark);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
  }
  .cv {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 26px;
    background: var(--yellow);
    color: var(--black);
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* The long label needs ~400px of button: below 520px it would wrap, so phones get the short one. */
  .cv-short {
    display: none;
  }
  @media (max-width: 519.98px) {
    .cv-long {
      display: none;
    }
    .cv-short {
      display: inline;
    }
  }
  .photo {
    flex: 1 1 240px;
    max-width: 320px;
    min-width: 220px;
    align-self: center;
  }
  /* Side by side with the text (wide screens): keep the picture off the right edge of the
     content area. Below 1000px the margin would push it under the text too early (it wraps
     around 870px anyway, and then needs no extra space). */
  @media (min-width: 1000px) {
    .photo {
      margin-right: clamp(32px, 6vw, 96px);
    }
  }
  .portrait {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
