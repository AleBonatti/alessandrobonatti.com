---
import SectionHeader from '../SectionHeader.astro';
import Rich from '../Rich.astro';
import { inline } from '../../lib/inline';
import type { SiteContent } from '../../content.config';

interface Props {
  t: SiteContent;
}

const { about } = Astro.props.t;
---

<section id="about">
  <div class="container">
    <SectionHeader title={about.title} />
    <p class="rv statement">
      <span class="serif-i">{about.lead}</span><br /><Fragment set:html={inline(about.statement)} />
    </p>
    <Rich text={about.body} class="rv body" />
  </div>
</section>

<style>
  .statement {
    margin: 0 0 36px;
    max-width: 1080px;
    /* A clear step below the hero name (46–88px), so the name leads the first screens. */
    font-size: clamp(28px, 2.9vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  /* One paragraph at a comfortable reading width (~65 characters per line). */
  .body {
    max-width: 980px;
    margin: 0;
    color: var(--grey-dark);
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.55;
  }
</style>
