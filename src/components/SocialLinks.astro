---
/** Square social buttons (LinkedIn, GitHub, WhatsApp, Telegram). 52px in the hero, 48px in Say hej!.
 *  `only` limits them to some ids: the hero shows just the professional profiles. */
import Icon from './Icon.astro';
import { profile } from '../data/profile';

type SocialId = (typeof profile.social)[number]['id'];

interface Props {
  size: 'lg' | 'md';
  only?: readonly SocialId[];
}

const { size, only } = Astro.props;
const links = only ? profile.social.filter((s) => only.includes(s.id)) : profile.social;
const iconSize = size === 'lg' ? 20 : 18;
---

<div class="socials">
  {
    links.map((s) => (
      <a class:list={['soc', `soc--${size}`]} href={s.url} aria-label={s.label} target="_blank" rel="noopener">
        <Icon name={s.id} size={iconSize} />
      </a>
    ))
  }
</div>

<style>
  .socials {
    display: flex;
    gap: 8px;
  }
  .soc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* #777 on black is ~4.7:1, so the buttons' edges are visible (#444 was ~2.2:1). */
    border: 1px solid #777;
    color: var(--white);
  }
  .soc--lg {
    width: 52px;
    height: 52px;
  }
  .soc--md {
    width: 48px;
    height: 48px;
  }
</style>
